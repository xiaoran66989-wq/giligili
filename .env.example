# Copy this file to .env for local development and replace the placeholders.
MYSQL_ROOT_PASSWORD=change-this-password
MYSQL_DSN=root:change-this-password@tcp(mysql:3306)/giligili?charset=utf8mb4&parseTime=True&loc=Local
REDIS_ADDR=redis:6379
REDIS_PW=
REDIS_DB=0
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
GIN_MODE=debug
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Required only for direct uploads to Aliyun OSS.
OSS_END_POINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
